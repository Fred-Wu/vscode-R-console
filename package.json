{
  "name": "vsc-r-console",
  "displayName": "R Console for VS Code",
  "description": "A lightweight R console for VS Code",
  "version": "0.5.0",
  "publisher": "RConsole",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "images/Rlogo.png",
  "galleryBanner": {
    "color": "#2C6DB2",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fred-Wu/vscode-R-console.git"
  },
  "bugs": {
    "url": "https://github.com/Fred-Wu/vscode-R-console/issues"
  },
  "homepage": "https://github.com/Fred-Wu/vscode-R-console#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "r",
    "rstats",
    "console",
    "terminal",
    "statistics",
    "data-science"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:r",
    "onLanguage:rmd"
  ],
  "files": [
    "dist/**",
    "images/**",
    "bundled/bin/**",
    "resources/r/**",
    "package.nls.json",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "r-console.createTerminal",
        "title": "Create R Console",
        "category": "R Console"
      },
      {
        "command": "r-console.createTerminalSide",
        "title": "Create R Console in Side Editor",
        "category": "R Console"
      },
      {
        "command": "r-console.managePersistentSessions",
        "title": "Manage Persistent Sessions...",
        "category": "R Console"
      },
      {
        "command": "r-console.insertPipeOperator",
        "title": "Insert Pipe Operator",
        "category": "R Console"
      },
      {
        "command": "r-console.triggerCompletion",
        "title": "Show Completions",
        "category": "R Console"
      },
      {
        "command": "r-console.restoreDefaultName",
        "title": "Restore Default Name",
        "category": "R Console"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "r-console.restoreDefaultName",
          "when": "resourceScheme == vscode-terminal && rConsole.consoleActive",
          "group": "1_modification"
        }
      ],
      "terminal/title/context": [
        {
          "command": "r-console.restoreDefaultName",
          "when": "rConsole.consoleActive",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "r-console.triggerCompletion",
          "when": "false"
        },
        {
          "command": "r-console.restoreDefaultName",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "r-console.triggerCompletion",
        "key": "f7",
        "when": "terminalFocus && rConsole.consoleActive"
      },
      {
        "command": "r-console.insertPipeOperator",
        "key": "ctrl+alt+m",
        "when": "terminalFocus && rConsole.consoleActive"
      }
    ],
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "r-console.insertPipeOperator"
      ]
    },
    "configuration": {
      "title": "R Console",
      "properties": {
        "r.console.autoMatch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert matching brackets and quotes."
        },
        "r.console.tabSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces for indentation."
        },
        "r.console.pipeOperator": {
          "type": "string",
          "enum": [
            "|>",
            "%>%"
          ],
          "default": "|>",
          "description": "Pipe operator to insert for chain operations. The default keybinding is Ctrl+Alt+M."
        }
      }
    }
  },
  "extensionDependencies": [
    "REditorSupport.r"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package:extension && npm run build:sidecar && npm run stage:sidecar",
    "build:sidecar": "node scripts/build-sidecar.js",
    "stage:sidecar": "node scripts/stage-sidecar.js",
    "check-types": "tsc --noEmit -p ./",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package:extension": "npm run check-types && node esbuild.js --production",
    "package:vsix": "node scripts/package-vsix.js",
    "package": "npm run vscode:prepublish && npm run package:vsix"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.7",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "vscode-languageclient": "^9.0.1"
  }
}
